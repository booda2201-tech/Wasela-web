{
  "headers": [
    {
      "source": "/assets/gif/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://waseela.somee.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}